from collections.abc import Hashable, Mapping
from pathlib import Path
from typing import Any, NoReturn, overload

import pandas as pd
import xarray as xr

SourcePath = str | Path
Source = SourcePath | list[SourcePath]


class xsnowDataset:
    """Typed public surface for xsnow's xarray-backed dataset wrapper.

    The runtime class intentionally uses composition: an ``xsnowDataset`` stores
    the real ``xarray.Dataset`` in ``.data`` and forwards unknown attributes to
    that object. This stub mirrors that design instead of pretending that
    ``xsnowDataset`` inherits from ``xr.Dataset``.

    The explicit method list is deliberately curated. It covers xsnow-native
    methods and the common xarray operations used in normal xsnow workflows,
    while keeping IDE autocomplete focused on the xsnow API. For less common
    xarray operations, use ``.to_xarray()`` when precise static typing matters.
    Dynamic coordinates and data variables, such as ``xs.time`` or
    ``xs.density``, are accepted through ``__getattr__`` and therefore typed as
    ``Any``.
    """

    data: xr.Dataset

    def __init__(self, source: "xr.Dataset | xsnowDataset") -> None: ...

    # Basic xarray-like dataset state exposed by the wrapper.
    @property
    def attrs(self) -> dict[Any, Any]: ...
    @property
    def coords(self) -> Any: ...
    @property
    def data_vars(self) -> Any: ...
    @property
    def dims(self) -> Mapping[Hashable, int]: ...
    @property
    def encoding(self) -> dict[Any, Any]: ...
    @property
    def indexes(self) -> Any: ...
    @property
    def sizes(self) -> Mapping[Hashable, int]: ...
    @property
    def variables(self) -> Mapping[Hashable, Any]: ...

    @overload
    def __getitem__(self, key: Hashable) -> xr.DataArray: ...
    @overload
    def __getitem__(self, key: list[Hashable]) -> xr.Dataset: ...
    @overload
    def __getitem__(self, key: Mapping[Any, Any]) -> xr.Dataset: ...
    def __setitem__(
        self,
        key: Hashable | list[Hashable] | Mapping[Any, Any],
        value: Any,
    ) -> None: ...
    def __contains__(self, key: object) -> bool: ...
    def __dir__(self) -> list[str]: ...
    def __repr__(self, *, force_details: bool = False) -> str: ...

    # Escape hatch for forwarded xarray attributes, dynamic coordinates, and
    # data variables. This keeps valid runtime use type-checkable, but the
    # returned object is intentionally Any.
    def __getattr__(self, name: str) -> Any: ...

    # xsnow-native core methods.
    def copy(self, deep: bool = False) -> "xsnowDataset": ...
    def merge_smet(
        self,
        source: Source,
        var_prefix: str | None = None,
        **kwargs: Any,
    ) -> "xsnowDataset": ...
    def to_xarray(self) -> xr.Dataset: ...
    def compute_hs(self) -> "xsnowDataset": ...
    def compute_z_depth(self) -> "xsnowDataset": ...
    def update_profile_status(self) -> "xsnowDataset": ...
    def profile_status_summary(self) -> None: ...
    def to_gpu(self) -> "xsnowDataset": ...
    def to_cpu(self) -> "xsnowDataset": ...

    # xsnow-native methods registered from I/O and helper modules.
    def append_latest(
        self,
        source: Source,
        **kwargs: Any,
    ) -> "xsnowDataset": ...
    def trim_padding(
        self,
        **kwargs: Any,
    ) -> "xsnowDataset": ...
    def reorder_dims(
        self,
        **kwargs: Any,
    ) -> "xsnowDataset": ...
    def print(
        self,
        *values: Any,
        force_details: bool = False,
        **kwargs: Any,
    ) -> None: ...

    def to_pro(
        self,
        path: SourcePath,
        **kwargs: Any,
    ) -> None: ...
    def to_smet(
        self,
        path: SourcePath,
        **kwargs: Any,
    ) -> None: ...
    def to_netcdf(
        self,
        path: SourcePath,
        **kwargs: Any,
    ) -> None: ...
    def to_zarr(
        self,
        path: SourcePath,
        **kwargs: Any,
    ) -> None: ...

    def fill_gaps_with(
        self,
        other: "xsnowDataset | xr.Dataset",
        **kwargs: Any,
    ) -> "xsnowDataset": ...
    def overwrite_with(
        self,
        other: "xsnowDataset | xr.Dataset",
        **kwargs: Any,
    ) -> "xsnowDataset": ...
    def update(self, *args: Any, **kwargs: Any) -> NoReturn: ...
    def combine_first(self, *args: Any, **kwargs: Any) -> NoReturn: ...

    # Curated xarray methods that return a Dataset at runtime and are rewrapped
    # by xsnowDataset.__getattr__.
    def sel(self, *args: Any, **kwargs: Any) -> "xsnowDataset": ...
    def isel(self, *args: Any, **kwargs: Any) -> "xsnowDataset": ...
    def where(self, *args: Any, **kwargs: Any) -> "xsnowDataset": ...
    def squeeze(self, *args: Any, **kwargs: Any) -> "xsnowDataset": ...
    def assign(self, *args: Any, **kwargs: Any) -> "xsnowDataset": ...
    def assign_coords(self, *args: Any, **kwargs: Any) -> "xsnowDataset": ...
    def rename(self, *args: Any, **kwargs: Any) -> "xsnowDataset": ...
    def swap_dims(self, *args: Any, **kwargs: Any) -> "xsnowDataset": ...
    def expand_dims(self, *args: Any, **kwargs: Any) -> "xsnowDataset": ...
    def drop_vars(self, *args: Any, **kwargs: Any) -> "xsnowDataset": ...
    def drop_sel(self, *args: Any, **kwargs: Any) -> "xsnowDataset": ...
    def drop_dims(self, *args: Any, **kwargs: Any) -> "xsnowDataset": ...
    def transpose(self, *args: Any, **kwargs: Any) -> "xsnowDataset": ...
    def sortby(self, *args: Any, **kwargs: Any) -> "xsnowDataset": ...
    def fillna(self, *args: Any, **kwargs: Any) -> "xsnowDataset": ...
    def dropna(self, *args: Any, **kwargs: Any) -> "xsnowDataset": ...
    def mean(self, *args: Any, **kwargs: Any) -> "xsnowDataset": ...
    def sum(self, *args: Any, **kwargs: Any) -> "xsnowDataset": ...
    def min(self, *args: Any, **kwargs: Any) -> "xsnowDataset": ...
    def max(self, *args: Any, **kwargs: Any) -> "xsnowDataset": ...
    def count(self, *args: Any, **kwargs: Any) -> "xsnowDataset": ...
    def any(self, *args: Any, **kwargs: Any) -> "xsnowDataset": ...
    def all(self, *args: Any, **kwargs: Any) -> "xsnowDataset": ...
    def compute(self, *args: Any, **kwargs: Any) -> "xsnowDataset": ...
    def load(self, *args: Any, **kwargs: Any) -> "xsnowDataset": ...
    def persist(self, *args: Any, **kwargs: Any) -> "xsnowDataset": ...
    def chunk(self, *args: Any, **kwargs: Any) -> "xsnowDataset": ...
    def unify_chunks(self, *args: Any, **kwargs: Any) -> "xsnowDataset": ...

    # Common conversions and comparisons that do not return xsnowDataset.
    def to_array(self, *args: Any, **kwargs: Any) -> xr.DataArray: ...
    def to_dataframe(self, *args: Any, **kwargs: Any) -> pd.DataFrame: ...
    def equals(self, other: Any) -> bool: ...
    def identical(self, other: Any) -> bool: ...
    def broadcast_equals(self, other: Any) -> bool: ...


class DatasetDecorator(xsnowDataset):
    @property
    def base(self) -> xsnowDataset: ...
